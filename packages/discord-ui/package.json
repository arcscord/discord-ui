{
  "name": "@arcscord/discord-ui",
  "version": "0.2.0",
  "description": "React primitives and data models for Discord message interfaces.",
  "type": "module",
  "license": "MIT",
  "author": "Arcoz0308",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcscord/discord-ui.git",
    "directory": "packages/discord-ui"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES",
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./highlight": {
      "types": "./dist/highlight.d.mts",
      "import": "./dist/highlight.mjs"
    },
    "./themes": {
      "types": "./dist/themes.d.mts",
      "import": "./dist/themes.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.eslint.json"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@arcscord/discord-ui-core": "workspace:^"
  }
}
