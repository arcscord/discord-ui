{
  "name": "@arcscord/discord-ui",
  "version": "0.0.0",
  "description": "React primitives and data models for Discord message interfaces.",
  "type": "module",
  "license": "MIT",
  "author": "Arcoz0308",
  "files": [
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./highlight": {
      "types": "./dist/highlight.d.mts",
      "import": "./dist/highlight.mjs"
    },
    "./themes": {
      "types": "./dist/themes.d.mts",
      "import": "./dist/themes.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.eslint.json"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "discord-markdown-parser": "1.3.1",
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0"
  }
