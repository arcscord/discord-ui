{
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "author": "Arcoz0308",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcscord/discord-ui.git",
    "directory": "packages/discord-ui-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "name": "@arcscord/discord-ui-core",
  "description": "Framework-independent Discord display models, content processing, themes and styles.",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./themes": {
      "types": "./dist/themes.d.mts",
      "import": "./dist/themes.mjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.mts",
      "import": "./dist/markdown.mjs"
    },
    "./emoji": {
      "types": "./dist/emoji.d.mts",
      "import": "./dist/emoji.mjs"
    },
    "./highlight": {
      "types": "./dist/highlight.d.mts",
      "import": "./dist/highlight.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.eslint.json"
  },
  "dependencies": {
    "@twemoji/parser": "17.0.2",
    "discord-markdown-parser": "1.3.1",
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0"
  }
}
