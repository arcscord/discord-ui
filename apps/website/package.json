{
  "name": "@arcscord/discord-ui-website",
  "private": true,
  "scripts": {
    "dev": "pnpm generate:vue && node ../../scripts/workspace/generate-avatars.mts website && docusaurus start --host 127.0.0.1",
    "build": "pnpm generate:vue && node ../../scripts/workspace/generate-avatars.mts website && docusaurus build",
    "preview": "docusaurus serve --host 127.0.0.1",
    "typecheck": "vue-tsc -p tsconfig.vue.json --noEmit && pnpm generate:vue && node ../../scripts/workspace/generate-website-examples.mts && tsc --noEmit",
    "generate:examples": "node ../../scripts/workspace/generate-website-examples.mts",
    "generate:vue": "node ../../scripts/workspace/generate-vue-examples.mts"
  },
  "dependencies": {
    "@arcscord/discord-ui": "workspace:*",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/theme-live-codeblock": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-live": "4.1.8",
    "sucrase": "3.35.1",
    "@arcscord/discord-ui-vue": "workspace:^"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2"
  }
}
